# Панель в контейнере. Собирать в образ нечего: у проекта ноль внешних зависимостей,
# только стандартная библиотека Python. Образ нужен не для воспроизводимости сборки,
# а для границы: агент внутри видит только смонтированный репозиторий, а не весь диск.
#
# 11 сентября 2026 задание по одной книге удалило лист персонажа из другой, а до того —
# три листа подряд. Все защиты от этого — запрет в промпте, жёсткие ссылки, проверка
# посторонних правок — держатся на том, что агент послушается или что панель успеет
# вернуть. Контейнер делает `workspace-write` настоящей границей, а не обещанием.

FROM node:24-bookworm-slim

# python3 — сама панель и скрипты; git — снимки дерева в проверке посторонних правок;
# node уже в образе, он же нужен проверке синтаксиса страницы панели. tzdata — чтобы часы
# заданий совпадали с вашими: без неё контейнер живёт по UTC, и «кончилось 16:02» в панели
# расходится с настенными часами на три часа.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

# Операторы. Версии закреплены нарочно: «последняя» превращает контейнер в лотерею,
# а поведение агента — часть контракта этого проекта.
ARG CODEX_VERSION=0.154.0
ARG CLAUDE_VERSION=2.1.268
RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
                   "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
 && npm cache clean --force \
 # Оба CLI держат платформенный бинарник в **необязательной** зависимости, и её неудачная
 # загрузка сборку не роняет: образ собирается молча сломанным, а выясняется это на первом
 # задании. Поэтому проверяем здесь — пусть падает сборка, а не работа.
 && codex --version \
 && claude --version

# Репозиторий приезжает томом и принадлежит хозяину, а не root. Без этого git отказывается
# с ним работать («dubious ownership»), и проверка посторонних правок слепнет молча.
RUN git config --global --add safe.directory /work

# pytest ставится отдельно и только для проверок: в работе панели он не нужен.
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir pytest
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /work
EXPOSE 8770

# Внутри контейнера панель слушает все адреса — наружу её выпускает compose, и только
# на 127.0.0.1 хозяина. Аутентификации у панели нет: порт, открытый в сеть, отдаёт
# кому угодно право тратить ваши деньги на генерацию.
CMD ["python3", "panel/server.py", "--host", "0.0.0.0", "--port", "8770"]
